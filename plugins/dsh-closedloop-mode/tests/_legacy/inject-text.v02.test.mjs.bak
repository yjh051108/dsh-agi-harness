import { test } from 'node:test'
import assert from 'node:assert/strict'
import {
  rejectAck, offReceipt, starPurpose, northStarLong, northStarShort, costCalibrateGuide, decomposeGuide,
  VERSION, specSheet, reviewPendingText, rollingKickoff, cycleGateNote, verifyHint, starAnchor, convergeLaw,
  doSummary, verifySummary, delegateSpec, workflowSpec, costAuditSpec, dualSpec, formSection,
  cycleFocus, cycleGroupOpen, cycleLast, settleNote, settleGuide, terminalGuide,
} from '../src/inject-text.js'

test('六态入口件齐（与 STAGE_SEMANTICS 对应）', () => {
  for (const fn of [costCalibrateGuide, decomposeGuide, reviewPendingText, rollingKickoff, settleGuide, terminalGuide]) {
    assert.equal(typeof fn, 'function')
  }
  assert.equal(VERSION, '0.2.0')
  assert.equal(typeof settleNote, 'function')
})

test('costCalibrateGuide：选择题+档位题+确认制+闭环兜底', () => {
  const t = costCalibrateGuide('做 X')
  assert.match(t, /ask_user_question/)
  assert.match(t, /代价·标定/)
  assert.match(t, /minor\/major\/catastrophic/)
  assert.match(t, /确认制/)
  assert.match(t, /cost_set\*\*\(purpose, assertions=逐条\{text,severity,source\}/)
  assert.match(t, /闭不了环就标注假设，而不是不写/)
})

test('decomposeGuide：单块门禁+容量带+不变式衔接+decompose/freeze+闭合即推进元规则', () => {
  const t = decomposeGuide('任务X', 5)
  assert.match(t, /单块门禁（第一铁律/)
  assert.match(t, /合计 3-5/)
  assert.match(t, /不是名词配额/)
  assert.match(t, /concepts 字段记"本块建立的不变式\/近场锚"/)
  assert.match(t, /想好就调 \*\*decompose\*\*（groups=组\+块一次全量提交/)
  assert.match(t, /vIn→vOut 档链/)
  assert.match(t, /闭合即推进（converge 三要素全过）= 唯一前进路径/)
  assert.match(t, /借口清单/)
})

test('cycleFocus：判定标准前置 + 预言家岗位 + 基线 + 闭合即推进', () => {
  const item = { title: '触发与首注', spec: '验证单注', accept: ['日志中恰 1 次', '工具就位'], do: 'self', verify: 'self', concepts: ['a'] }
  const t = cycleFocus('组', item, '前项', '为测试者的目的宣言十二字以上', 'auto')
  assert.match(t, /【当前块·组】.*上一块「前项」已闭合/)
  assert.match(t, /【本块判定标准】/)
  assert.match(t, /· 日志中恰 1 次/)
  assert.match(t, /预言家/)
  assert.match(t, /最优律基线/)
  assert.match(t, /闭合即推进/)
})

test('cycleFocus/cycleLast/cycleGroupOpen：强度注记与组首末变体', () => {
  const item = { title: 'X', spec: 's', accept: ['a'], do: 'subagent', verify: 'redteam', concepts: ['c'] }
  const t = cycleFocus('组', item, null, '', 'self-redteam')
  assert.match(t, /【执行形态·委派】/)
  assert.match(t, /对抗审块/)
  assert.match(t, /检测模式：单自对抗审/)
  const dual = cycleFocus('组', { ...item, do: 'self', verify: 'dual' }, null, '', 'auto')
  assert.match(dual, /双通道块/)
  const open = cycleGroupOpen('组', { title: '首块', spec: 's', accept: [], do: 'self', verify: 'self' }, '为目的写满十二个字的宣言', 'auto')
  assert.match(open, /【新组·组】/)
  assert.match(open, /先推导最优律契约再开工/)
  assert.match(open, /北极星·本组/)
  const last = cycleLast('组', item, '前项', 'p', 'auto')
  assert.match(last, /本组最后一块/)
  assert.match(last, /组核对\/终端校验.*自动到来/)
})

test('convergeLaw：统一基线（三要素+dip+定理6，无三选一分支）', () => {
  const t = convergeLaw()
  assert.match(t, /ΔV cost-to-go 序带严格降/)
  assert.match(t, /实测 ≠ 预测\(通道\)/)
  assert.match(t, /双通道标识两两不同/)
  assert.match(t, /同模型签名重 declare 直拒（定理6）/)
  assert.match(t, /不存在"调试"状态/)
})

test('cycleGateNote/verifyHint：分档与提示', () => {
  assert.match(cycleGateNote({ verify: 'self' }, 'auto'), /最优律基线/)
  assert.match(cycleGateNote({ verify: 'weird' }, 'auto'), /最优律基线/)
  assert.match(cycleGateNote({ verify: 'dual' }, 'subagent'), /【检测模式：单 subagent】[\s\S]*双通道块/)
  assert.match(cycleGateNote({ verify: 'redteam' }, 'auto'), /未过审不得滚动/)
  assert.match(verifyHint('self-redteam'), /未过审不推进/)
})

test('formSection/skill 卡：委派与编排的盘档标准纪律', () => {
  const item = { title: 'X', spec: '任务 X', accept: ['标准1'], do: 'subagent', verify: 'redteam' }
  const fs1 = formSection(item)
  assert.match(fs1, /【委派 skill】/)
  assert.match(fs1, /判定标准逐条对应：\n· 标准1/)
  assert.match(fs1, /不得删减\/软化\/自造标准/)
  assert.match(fs1, /代价对抗审规范/)
  assert.match(fs1, /自演对抗审=同义务/)
  const w = formSection({ ...item, do: 'workflow', verify: 'dual' })
  assert.match(w, /【编排 skill】/)
  assert.match(w, /携带判定标准（不可剥离）/)
  assert.match(w, /双轨并行规范/)
})

test('settleGuide/settleNote：组全闭合→四档落账指路（机械非仪式）', () => {
  const g = { title: '组A', accept: ['a'], verify: 'redteam', items: [{ title: 'x', status: 'completed' }] }
  const t = settleGuide(g)
  assert.match(t, /【组核对·组A】/)
  assert.match(t, /待组级对抗审/)
  assert.match(t, /cost_audit\(scope="group", title="组A"/)
  assert.match(settleGuide({ ...g, verify: 'user' }), /待用户复核/)
  assert.match(settleGuide({ ...g, verify: 'subagent' }), /独立复核/)
  const selfT = settleGuide({ ...g, verify: 'self' })
  assert.match(selfT, /子空间核对自动落账/)
  assert.match(selfT, /机械非仪式|无手动打点位/)
})

test('specSheet：cost 断言档位分布 + 阅读树（v0.2 键）', () => {
  const state = {
    cost: { aligned: true, purpose: '为测试者核对档位', assertions: [{ text: 'A1', severity: 'catastrophic', source: 'S' }, { text: 'A2', severity: 'minor', source: 'S' }], nonGoals: ['N'], assumptions: [] },
    plan: { groups: [{ title: '组', spec: 's', accept: ['a'], items: [{ title: '块', spec: 's2', accept: ['b'], do: 'self', verify: 'self', status: 'pending' }] }] },
  }
  const t = specSheet(state)
  assert.match(t, /终端代价 Q_N/)
  assert.match(t, /catastrophic×1 major×0 minor×1/)
  assert.match(t, /#L2 块/)
  assert.match(specSheet({ cost: { aligned: false }, plan: { groups: [] } }), /代价未定稿/)
})

test('rollingKickoff/northStar 系：入场宣言+长版一次+浓缩判定锚', () => {
  const state = { cost: { aligned: true, purpose: '为都市人三分钟治愈' } }
  const t = rollingKickoff(state)
  assert.match(t, /【滚动·控制】/)
  assert.match(t, /闭合即推进/)
  assert.match(t, /北极星·元认知/)
  assert.match(t, /闭合是对目的的闭合/)
  assert.match(northStarShort(state, { title: '某块', accept: ['一个比较长的判定标准条目用来测试截断行为ABC'] }), /当前唯一任务=某块，判定锚=一个比较长的判定标准条目用来测试截断行为…/)
})

test('starAnchor/starPurpose：目的锚定一行+取源 cost', () => {
  assert.equal(starPurpose({ cost: { purpose: ' P ' } }), 'P')
  assert.equal(starPurpose({}), '')
  const a = starAnchor({ accept: ['断言一'] }, '一个足够长的目的宣言用来验证四十六的截断行为是否工作正常继续加长看看')
  assert.match(a, /开工前一眼（北极星锚定）/)
  assert.match(a, /本块判定锚：断言一/)
  assert.match(starAnchor({ accept: [], spec: '任务行\n第二行' }, ''), /目的锚定/)
})

test('rejectAck/offReceipt/terminalGuide：解锁回环+关闭回执+终端两票', () => {
  assert.match(rejectAck(), /decompose 重新呈交[\s\S]*freeze/)
  assert.match(rejectAck(), /不要沿用旧树重冻/)
  assert.match(offReceipt(), /最优律协议已关闭/)
  const t = terminalGuide()
  assert.match(t, /terminal_check/)
  assert.match(t, /体验一票否决/)
  assert.match(t, /不可被机械报告替代/)
})

test('doSummary/verifySummary：选项一句话摘要', () => {
  assert.match(doSummary('subagent'), /按盘档标准独立核对→推进/)
  assert.match(doSummary('daemon'), /守护循环/)
  assert.match(doSummary('self'), /做→核→闭合/)
  assert.match(verifySummary('redteam'), /pass 才可滚动/)
  assert.match(verifySummary('dual'), /完成后对照/)
})
