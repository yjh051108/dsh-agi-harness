import { test, beforeEach } from 'node:test'
import assert from 'node:assert/strict'
import { rmSync, mkdtempSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { decomposeDefinition, freezeDefinition, advanceAndClose, terminalCheckDefinition, costSetDefinition, costAuditDefinition, reviseDoDefinition, optimalDeclareDefinition } from '../src/tools.js'
import { TOOL_NAMES } from '../src/index.js'
import { declareStep, convergeStep } from '../src/optimal-engine.js'
import { initMode, trigger, onCommitStar, onEditL1, onLockL1, onEditL2, onLockL2, onReviewApproved, loadState, saveState, stateFileFor } from '../src/mode-state.js'

// 测试级状态目录（磁盘权威：execute 直读写盘）
const TMP = mkdtempSync(join(tmpdir(), 'graded-test-'))
process.env.DSH_HOME = TMP
beforeEach(() => { try { rmSync(stateFileFor('sid-1'), { force: true }) } catch { /* 幂等 */ } })

/** v0.2 起步：代价定稿（cost_set/onCommitStar 态）后进入 l1-edit（分解可提交态）。 */
function begin(task = '任务') {
  return onCommitStar(trigger(initMode(), task), { purpose: '测试目的：验证契约' })
}

/** v0.2 构造助手：decompose 全量一次提交 + freeze 单一冻结 → review。 */
async function toReview(deps, groups) {
  await run(decomposeDefinition(deps), deps, { groups })
  return run(freezeDefinition(deps), deps, {})
}

/** deps 兼容双轨：旧签名 setState(state) / 新签名 setState(sid, state)；执行侧统一走盘。 */
function makeHarness(askResult) {
  const store = { state: initMode() }
  const deps = {
    getState: () => loadState('sid-1') || store.state, // execute 写盘 → 断言读盘（权威）
    setState: (a, b) => {
      if (b === undefined) { b = a; }
      store.state = b
      saveState('sid-1', b) // 与 execute 的盘读取同源
    },
    askUser: async () => askResult,
  }
  return { store, deps }
}

/** 模拟一次工具执行（提供最小 exec）。 */
async function run(def, deps, args) {
  const exec = {
    agent: {
      session: {
        id: 'sid-1',
        events: [],
        append: (type, data) => {},
      },
      followup: () => {},
    },
  }
  return def.execute(args, exec)
}

test('definition 形状：decompose/freeze 参数与必填齐全（v0.2 单锁）', () => {
  const { deps } = makeHarness()
  const d = decomposeDefinition(deps)
  const f = freezeDefinition(deps)
  assert.equal(d.name, 'decompose')
  assert.deepEqual(d.parameters.required, ['groups'])
  assert.equal(d.parameters.properties.level, undefined) // 无层级参数（两级门控已撤）
  assert.equal(f.name, 'freeze')
  assert.deepEqual(f.parameters.required, [])
})

test('decompose：未激活拒/未定稿拒/一次提交树完整（组含块）', async () => {
  const { deps } = makeHarness()
  const d = decomposeDefinition(deps)
  const G = [{ title: '分析', spec: '任务', accept: ['标准'], items: [{ title: '核验', spec: 's', accept: ['a'], do: 'self', verify: 'self', concepts: ['a'] }] }]
  await assert.rejects(() => run(d, deps, { groups: G }), /激活/) // off 未激活
  deps.setState(deps.getState(), trigger(initMode(), '任务')) // brainstorm 未定稿
  await assert.rejects(() => run(d, deps, { groups: G }), /cost_set/)
  deps.setState(deps.getState(), begin('任务'))
  const r = await run(d, deps, { groups: G })
  assert.match(r.text, /分解已提交/)
  assert.equal(deps.getState().plan.groups.length, 1)
})

test('freeze 后 decompose 被拒（冻结即锁，解锁唯一入口=审核拒绝）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: 'A', spec: 'x', accept: ['a'], items: [{ title: 'n', spec: 's', accept: ['a'], do: 'self', verify: 'self' }] }])
  await assert.rejects(() => run(decomposeDefinition(deps), deps, { groups: [{ title: '改', spec: 'x', accept: ['y'], items: [{ title: 'n2', spec: 's', accept: ['a'], do: 'self', verify: 'self' }] }] }), /已冻结|进行中/)
})

test('decompose 结构门：组无块=拒；块缺 do/verify=拒（一次全量语义）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), begin('任务'))
  const d = decomposeDefinition(deps)
  await assert.rejects(() => run(d, deps, { groups: [{ title: 'A', spec: 'x', accept: ['a'], items: [] }] }), /无块分解/)
  await assert.rejects(() => run(d, deps, { groups: [{ title: 'A', spec: 'x', accept: ['a'], items: [{ title: 'n', spec: 's', accept: ['a'] }] }] }), /do|verify/)
})

test('freeze → review：回执含档链（末块 at）+完整规格评审单', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), begin('任务'))
  const r = await toReview(deps, [{ title: '分析', spec: '任务', accept: ['标准'], items: [{ title: '核验', spec: 's', accept: ['a'], do: 'self', verify: 'self', concepts: ['a'] }] }])
  assert.match(r.text, /已冻结（推导评审待用户确认）/)
  assert.match(r.text, /完整规格评审单/)
  assert.match(r.text, /核验: near→at/) // N=1：rank(1)=near→rank(0)=at
  assert.equal(deps.getState().stage, 'review')
  assert.equal(deps.getState().vChain.length, 1)
})

test('freeze 多块链（N=2）：链含全部块、逐块承接、末块 at（判据②声明例）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), begin('任务'))
  const r = await toReview(deps, [{ title: '分析', spec: '任务', accept: ['标准'], items: [
    { title: '块甲', spec: 's', accept: ['a'], do: 'self', verify: 'self' },
    { title: '块乙', spec: 's', accept: ['b'], do: 'self', verify: 'self' }] }])
  assert.equal(deps.getState().vChain.length, 2)
  assert.equal(deps.getState().vChain[1].vOut, 'at') // 末块必达
  assert.equal(deps.getState().vChain[0].vOut, deps.getState().vChain[1].vIn) // 链连续（生成即自洽）
  assert.match(r.text, /块甲: near→near/) // rank(2)=near→rank(1)=near（粗档：两近档块——链为期望锚非块级硬门）
  assert.match(r.text, /块乙: near→at/)
})

test('freeze（review 重入）→ 幂等保持 review，树与链保留', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: '分析', spec: '任务', accept: ['标准'], items: [{ title: '核验', spec: 's', accept: ['a'], do: 'self', verify: 'self' }] }])
  const r2 = await run(freezeDefinition(deps), deps, {})
  assert.match(r2.text, /已冻结/)
  assert.equal(deps.getState().stage, 'review')
  assert.equal(deps.getState().plan.groups.length, 1)
})

// （原"edit_plan 未定稿门控"用例已并入 "decompose：未激活拒/未定稿拒"——单入口语义）

test('cost_set 自主激活：off → 定稿即激活 l1-edit；拒后不激活', async () => {
  const { deps } = makeHarness()
  const star = costSetDefinition()
  const r = await run(star, deps, { purpose: '为疲惫的都市人，在 3 分钟的微风与花开中进入治愈状态', assertions: [{ text: '3 秒内响应', severity: 'major', source: '用户确认原话' }] })
  assert.match(r.text, /自主激活（代价标定完成）/)
  assert.equal(deps.getState().stage, 'l1-edit')
  assert.equal(deps.getState().cost.aligned, true)
  assert.match(deps.getState().task, /自主进入/)
  deps.setState(deps.getState(), initMode())
  await assert.rejects(() => run(star, deps, { purpose: '好', assertions: [{ text: 'x', severity: 'major', source: 'y' }] }), /过短/)
  assert.equal(deps.getState().stage, 'off') // 先校验后落盘，拒不落
})

/* ---------- v0.2 cost_set 门控五例（定理 1/4 物化） ---------- */

const as = (over) => [{ text: '命令清单可跑通', severity: 'catastrophic', source: 'README 安装链实测', ...over }]

test('cost_set 门控1：assertions 空=拒（无断言=无代价函数）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), trigger(initMode(), '整理一份 README 文档'))
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为协作的开发者，把 README 变成 1 分钟可查的命令手册' }), /assertions 为空/)
})

test('cost_set 门控2：缺 severity 档=拒（指明 assertions[i]）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), trigger(initMode(), 't'))
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为测试者验证档位硬门存在（十二字以上）', assertions: [{ text: 'A1', source: 'x' }] }), /assertions\[0\].*档位/)
})

test('cost_set 门控3：缺 source 来源=拒（定理4：无源=无效）', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), trigger(initMode(), 't'))
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为测试者验证来源硬门存在（十二字以上）', assertions: as({ source: '  ' }) }), /assertions\[0\].*来源/)
})

test('cost_set 门控4：nonGoals 无确认位=拒；确认落盘', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), trigger(initMode(), 't'))
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为测试者验证确认制硬门（十二字以上）', assertions: as({}), nonGoals: ['不做重构'] }), /确认制/)
  const ok = await run(costSetDefinition(), deps, { purpose: '为测试者验证确认制落盘路径（十二字以上）', assertions: as({}), nonGoals: ['不做重构'], nonGoalsConfirmed: true })
  assert.match(ok.text, /非目标确认 1/)
  assert.equal(deps.getState().cost.nonGoalsConfirmed, true)
})

test('cost_set 门控5：合规落盘含档位分布+旧参数显式拒+develop 只读', async () => {
  const { deps } = makeHarness()
  deps.setState(deps.getState(), trigger(initMode(), '整理一份 README 文档'))
  const r = await run(costSetDefinition(), deps, {
    purpose: '为协作的开发者，把 README 从散落备注变成 1 分钟可查的命令手册',
    assertions: [...as({}), { text: '零依赖说明', severity: 'minor', source: '用户脑暴答复' }],
    assumptions: ['读者熟悉 Node'],
  })
  assert.match(r.text, /Q_N 2 条（catastrophic×1 major×0 minor×1）/)
  assert.match(r.text, /代价定稿/)
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为测试者尝试旧参数通道是否关闭（十二字以上）', requirements: ['x'] }), /已废/)
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '为测试者尝试模式参数是否关闭（十二字以上）', assertions: as({}), mode: 'research' }), /已废/)
  deps.setState(deps.getState(), onReviewApproved(onLockL2(onEditL2(onLockL1(onEditL1(deps.getState(), [{ title: 'A', spec: 'x', accept: ['y'] }])), [{ title: 'A', items: [{ title: 'a', spec: 's', accept: ['y'], do: 'self', verify: 'self' }] }]))))
  await assert.rejects(() => run(costSetDefinition(), deps, { purpose: '开发期改目的宣言尝试（十二字以上）', assertions: as({}) }), /只读|修改/)
})

test('freeze 复检：规格不全被拒且状态不污染（先复检后写入）', async () => {
  const { deps } = makeHarness()
  const f = freezeDefinition(deps)
  deps.setState(deps.getState(), begin('任务'))
  // 旁路：盘上直写缺组 accept 的树 → freeze 拒
  deps.setState(deps.getState(), onEditL1(deps.getState(), [{ title: 'A', spec: 'x' }]))
  await assert.rejects(() => run(f, deps, {}), /缺验收标准|冻结复检/)
  assert.equal(deps.getState().stage, 'l1-edit') // 拒=不落 review、不生成链
  assert.equal(deps.getState().vChain.length, 0)
  // 旁路：块缺 verify → assertL2Groups 拒
  deps.setState(deps.getState(), onEditL1(deps.getState(), [{ title: 'A', spec: 'x', accept: ['a'] }]))
  deps.setState(deps.getState(), onEditL2(deps.getState(), [{ title: 'A', spec: 'x', accept: ['a'], items: [{ title: 'a', spec: 's', accept: ['a'], do: 'self' }] }]))
  await assert.rejects(() => run(f, deps, {}), /verify/)
  assert.equal(deps.getState().stage, 'l1-edit')
})

test('cost_audit：非 adversarial 拒 / reject 必附证据 / 轮次与再审批 / 旧 level 入参兼容一周期', async () => {
  const { deps } = makeHarness()
  const rt = costAuditDefinition()
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: 'A', spec: 'x', accept: ['a'], verify: 'redteam', items: [
    { title: '核验一', spec: 's', accept: ['a'], do: 'self', verify: 'self' },      // 未声明对抗审
    { title: '核验二', spec: 's', accept: ['b'], do: 'self', verify: 'redteam' }] }])
  deps.setState(deps.getState(), onReviewApproved(deps.getState()))
  // 非 adversarial 项 → 拒（新 scope 入参）
  await assert.rejects(() => run(rt, deps, { scope: 'block', title: '核验一', verdict: 'pass' }), /未声明对抗审/)
  // reject 必须附证据清单
  await assert.rejects(() => run(rt, deps, { scope: 'block', title: '核验二', verdict: 'reject' }), /证据清单/)
  // 打回 → issues 落盘 → 再审通过 → 轮次=2（块级过审自动补推进）
  const r1 = await run(rt, deps, { scope: 'block', title: '核验二', verdict: 'reject', issues: ['权重无源：accept#1 source=拍脑袋'] })
  assert.match(r1.text, /打回.*轮次=1.*再审批/)
  let it = deps.getState().plan.groups[0].items[1]
  assert.equal(it.costaudit.passed, false)
  assert.equal(it.costaudit.log.length, 1)
  // 栈上落推导闭合→过审→自动推进（对抗审不替代闭合门）
  declareStep('sid-1', { title: '核验二', invariants: ['x'], predictions: [{ key: 'k', value: '1', source: 's' }], cost: [{ failure: 'f', defense: 'd' }], law: [{ signal: 's', action: 'a' }], measure: { right: 'r', wrongSignal: 'w', channels: ['盘: a', '跑: b'] }, confidence: 'high' })
  convergeStep('sid-1', { agreed: ['k: 实测 1 ≠ 1（独立）'], discrepancies: [], dv: { beforeBand: 'far', measuredBand: 'near', channels: ['盘: x', '跑: y'] } })
  const r2 = await run(rt, deps, { scope: 'block', title: '核验二', verdict: 'pass' })
  assert.match(r2.text, /通过.*轮次=2.*过审即推进/)
  it = deps.getState().plan.groups[0].items[1]
  assert.equal(it.costaudit.passed, true)
  assert.equal(it.costaudit.rounds, 2)
  // 旧 level 入参兼容（一周期，语系块清理）：组级 L1≡group
  const g0 = deps.getState().plan.groups[0]
  assert.equal(g0.verify, 'redteam')
  await run(rt, deps, { level: 'L1', title: 'A', verdict: 'pass' })
  assert.equal(deps.getState().plan.groups[0].costaudit.rounds, 1)
})

test('revise_do：开发期改形态登记轨迹；枚举无效拒；verify 只读', async () => {
  const { deps } = makeHarness()
  const revise = reviseDoDefinition()
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: 'A', spec: 'x', accept: ['a'], items: [
    { title: '核验一', spec: 's', accept: ['a'], do: 'self', verify: 'self' }] }])
  deps.setState(deps.getState(), onReviewApproved(deps.getState()))
  // 枚举无效 → 拒
  await assert.rejects(() => run(revise, deps, { title: '核验一', do: 'hack' }), /无效/)
  // 修订成功 + doHistory 登记（from=self → to=subagent）
  const r = await run(revise, deps, { title: '核验一', do: 'subagent' })
  assert.match(r.text, /已修订「核验一」执行形态 → do=subagent/)
  assert.match(r.text, /verify 不变——核对承诺不因形态变化而打折/)
  const it = deps.getState().plan.groups[0].items[0]
  assert.equal(it.do, 'subagent')
  assert.equal(it.doHistory.length, 1)
  assert.equal(it.doHistory[0].from, 'self')
  assert.equal(it.doHistory[0].to, 'subagent')
  assert.equal(it.verify, 'self') // verify 未被触碰（只读）
})

test('对抗审链：未过审不推进 / 过审自动推进 / 无闭合推导先过审仍不推进 / 组级过审自动落账', async () => {
  const { deps } = makeHarness()
  const rt = costAuditDefinition(deps)
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: 'A', spec: 'x', accept: ['a'], verify: 'redteam', items: [
    { title: '核验一', spec: 's', accept: ['a'], do: 'self', verify: 'redteam' }] }])
  deps.setState(deps.getState(), onReviewApproved(deps.getState()))
  const liteExec = { agent: { session: { id: 'sid-1', events: [], append: () => {} }, followup: () => {}, steer: () => {} } }
  // 未过审：推进链拒
  assert.throws(() => advanceAndClose('sid-1', '核验一', liteExec), /未过对抗审（轮次=0）/)
  // 无推导闭合先过审 → 仍不推进（对抗审不替代闭合门）
  const rp0 = await run(rt, deps, { scope: 'block', title: '核验一', verdict: 'pass' })
  assert.match(rp0.text, /推导闭合未落/)
  // 栈上落闭合 → 再审过 → 自动推进
  declareStep('sid-1', { title: '核验一', invariants: ['a'], predictions: [{ key: 'k', value: '1', source: 's' }], cost: [], law: [{ signal: 'x', action: 'y' }], measure: { right: 'r', wrongSignal: 'w', channels: ['盘: a', '跑: b'] }, confidence: 'high' })
  convergeStep('sid-1', { agreed: ['k: 实测 1 ≠ 1（独立）'], discrepancies: [], dv: { beforeBand: 'far', measuredBand: 'near', channels: ['盘: x', '跑: y'] } })
  const rp = await run(rt, deps, { scope: 'block', title: '核验一', verdict: 'pass' })
  assert.match(rp.text, /过审即推进[\s\S]*#L2 核验一 ✅/)
  assert.equal(deps.getState().plan.groups[0].items[0].status, 'completed')
  // 组全闭合但组级对抗审未过 → 不落账；过审 → settle 自动 locked
  const notesPre = deps.getState().plan.groups[0]
  assert.equal(notesPre.locked, false)
  await run(rt, deps, { scope: 'group', title: 'A', verdict: 'pass' })
  assert.equal(deps.getState().plan.groups[0].locked, true)
})

test('工具集唯一真相：TOOL_NAMES=10 名（mark_task 不存在）+ terminal_check 阶段门', async () => {
  const { deps } = makeHarness()
  assert.equal(TOOL_NAMES.length, 10)
  assert.equal(new Set(TOOL_NAMES).size, 10)
  assert.equal(TOOL_NAMES.includes('mark_task'), false)
  assert.deepEqual([...TOOL_NAMES].sort(), ['cost_audit', 'cost_set', 'decompose', 'freeze', 'optimal_converge', 'optimal_declare', 'optimal_rollback', 'optimal_stack', 'revise_do', 'terminal_check'])
  // terminal_check：非 final 拒（唯一 throw 位）
  const tc = terminalCheckDefinition()
  deps.setState(deps.getState(), begin('任务'))
  await toReview(deps, [{ title: 'A', spec: 'x', accept: ['a'], items: [
    { title: 'b1', spec: 's', accept: ['a'], do: 'self', verify: 'self' }] }])
  deps.setState(deps.getState(), onReviewApproved(deps.getState()))
  await assert.rejects(() => run(tc, deps, {}), /final/)
  // final 态非零报告（块未闭合→交处置，不 throw）
  const sNow = deps.getState()
  deps.setState(sNow, { ...sNow, stage: 'final' })
  const rn = await run(tc, deps, {})
  assert.match(rn.text, /终端未归零.*b1/)
  // P 场修复活证：terminal_check 报告落盘（盘档 terminalReport 字段）
  const afterRn = deps.getState()
  assert.ok(afterRn.terminalReport, 'terminalReport 未落盘')
  assert.equal(afterRn.terminalReport.zero, false)
  assert.deepEqual(afterRn.terminalReport.remaining, ['b1'])
  // final+推导闭合齐→零报告
  const lite = { agent: { session: { id: 'sid-1', events: [], append: () => {} }, followup: () => {}, steer: () => {} } }
  declareStep('sid-1', { title: 'b1', invariants: ['x'], predictions: [{ key: 'k', value: '1', source: 's' }], cost: [{ failure: 'f', defense: 'd' }], law: [{ signal: 's', action: 'a' }], measure: { right: 'r', wrongSignal: 'w', channels: ['盘: a', '跑: b'] }, confidence: 'high' })
  convergeStep('sid-1', { agreed: ['k: 实测 1 ≠ 1（独立）'], discrepancies: [], dv: { beforeBand: 'far', measuredBand: 'near', channels: ['盘: x', '跑: y'] } })
  advanceAndClose('sid-1', 'b1', lite)
  const rz = await run(tc, deps, {})
  assert.match(rz.text, /终端归零/)
  assert.equal(deps.getState().terminalReport.zero, true)
})

test('6 工具定义形状：name/parameters 必填枚举齐全（v0.2 工具集）', () => {
  const defs = [costSetDefinition(), costAuditDefinition(), reviseDoDefinition()]
  const names = defs.map((d) => d.name).sort().join(',')
  assert.equal(names, 'cost_audit,cost_set,revise_do')
  // cost_set：purpose 必填
  assert.deepEqual(costSetDefinition().parameters.required, ['purpose'])
  // cost_audit：scope/title/verdict 必填,issues 可选（reject 时强制）
  assert.deepEqual(costAuditDefinition().parameters.required, ['scope', 'title', 'verdict'])
  // revise_do：title/do 必填,无 level 参数（固定 L2——verify 只读的设计面）
  assert.deepEqual(reviseDoDefinition().parameters.required, ['title', 'do'])
  assert.equal(reviseDoDefinition().parameters.properties.level, undefined)
})

// （原"commit_star 带 mode"用例已随三选一废除删除——旧参数显式拒断言并入 cost_set 门控5）

test('advanceAndClose：阶段门+单线聚焦（declare in_progress）+闭合滚动', async () => {
  const { deps } = makeHarness()
  const liteExec = { agent: { session: { id: 'sid-1', events: [], append: () => {} }, followup: () => {}, steer: () => {} } }
  const d = optimalDeclareDefinition()
  deps.setState(deps.getState(), begin('任务'))
  // 评审前推进被拒（阶段门）
  assert.throws(() => advanceAndClose('sid-1', '核验一', liteExec), /滚动\/终端校验阶段/)
  await toReview(deps, [{ title: '分析', spec: '任务', accept: ['标准'], items: [
    { title: '核验一', spec: 's', accept: ['a'], do: 'self', verify: 'self', concepts: ['a'] },
    { title: '核验二', spec: 's', accept: ['b'], do: 'self', verify: 'self', concepts: ['b'] }] }])
  deps.setState(deps.getState(), onReviewApproved(deps.getState()))
  // declare 命中盘档块 → in_progress 单线聚焦
  await run(d, deps, { title: '核验一', invariants: ['x'], predictions: [{ key: 'k', value: '1', source: 's' }], cost: [{ failure: 'f', defense: 'd' }], law: [{ signal: 's', action: 'a' }], measure: { right: 'r', wrongSignal: 'w', channels: ['盘: a', '跑: b'] }, confidence: 'high' })
  assert.equal(deps.getState().plan.groups[0].items[0].status, 'in_progress')
  const brief = advanceAndClose('sid-1', '核验一', liteExec)
  assert.match(brief, /#L2 核验一 ✅/)
  assert.equal(deps.getState().plan.groups[0].items[1].status, 'pending')
  assert.throws(() => advanceAndClose('sid-1', '不存在', liteExec), /不在计划里/)
})
